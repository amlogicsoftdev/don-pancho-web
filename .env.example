# Variables de entorno de Don Pancho & Burger
#
# 1. Copiá este archivo como .env.local (ya está en el .gitignore) y completá los valores.
# 2. Nunca pongas valores reales en este archivo: se sube al repo.
# 3. Los valores reales se cargan en Vercel o se pasan por el gestor de contraseñas, nunca por chat.
# 4. Cada desarrollador usa su propia base de datos (o rama de la base) de desarrollo.
#
# Cuando agregues una variable nueva al código, sumala acá con un comentario de para qué sirve.

# Conexión a la base de datos PostgreSQL de Neon (la de desarrollo de cada persona).
DATABASE_URL=

# Solo para `npm run db:seed`: crea un usuario dueño de prueba si ambas están definidas.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# Autenticación del panel (Better Auth).
# Secreto de al menos 32 caracteres; generalo con: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
# URL base del sitio: http://localhost:3000 en desarrollo, el dominio real en producción.
BETTER_AUTH_URL=http://localhost:3000

# Imágenes de los productos (Cloudinary). Se encuentran en el panel de Cloudinary > Settings > API Keys.
# El secreto nunca va al navegador: solo el servidor firma las subidas.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
